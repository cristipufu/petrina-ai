{
  "name": "petrina",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "engine": "bun packages/engine/src/cli.ts serve",
    "petrina": "bun packages/engine/src/cli.ts",
    "open": "bun packages/engine/src/cli.ts open --dev",
    "tauri": "bun run --cwd apps/desktop tauri",
    "build": "bun run --cwd apps/desktop build",
    "typecheck": "bun run --parallel --workspaces typecheck",
    "test": "bun packages/engine/test/quality/full-run.ts",
    "test:conventions": "bun packages/engine/test/quality/repository.ts conventions",
    "test:impact": "bun packages/engine/test/quality/repository.ts impact",
    "test:coverage": "bun packages/engine/test/quality/coverage.ts",
    "test:install-browser": "bun packages/agent-runtime/node_modules/@playwright/mcp/cli.js install-browser --no-shell chromium"
  }
}
